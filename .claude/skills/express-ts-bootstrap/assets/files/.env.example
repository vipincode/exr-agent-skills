# Copy to .env and fill in. config/env.ts validates these at startup and exits on failure.
NODE_ENV=development
PORT=4000

# Proxies in front of this API. 1 = behind the Next.js BFF (frontend-<name>) or one load
# balancer; 2 = BFF + load balancer; 0 = clients connect directly. Wrong values either
# rate-limit all users as one IP (too low) or let clients spoof their IP (too high).
TRUST_PROXY=1

# Mongo connection string (docker-compose ships a local mongo on 27017)
MONGODB_URI=mongodb://localhost:27017/app

# Auth — JWT_SECRET must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

LOG_LEVEL=info
