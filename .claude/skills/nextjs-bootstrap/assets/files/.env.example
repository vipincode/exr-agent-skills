# Server-only secrets (NO NEXT_PUBLIC_ prefix — never exposed to the browser).
# The BFF Route Handlers and middleware read these; the backend URL stays a server secret.
BACKEND_URL=http://localhost:4000

# Cookie names used for the auth session (httpOnly, set server-side).
AUTH_ACCESS_COOKIE=access_token
AUTH_REFRESH_COOKIE=refresh_token

# Browser-exposed values use the NEXT_PUBLIC_ prefix. When you add one here,
# also declare it in src/lib/env.ts under `client` AND mirror it in
# `experimental__runtimeEnv` (T3 Env — Next.js inlines NEXT_PUBLIC_* at build). E.g.:
# NEXT_PUBLIC_APP_NAME=My App
